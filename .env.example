# Any OpenAI-compatible endpoint works. Defaults to Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-or-openai-key        # GROQ_API_KEY / OPENAI_API_KEY are also read
# Local, fully offline alternative (Ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# DRONEDOCS__LLM__MODEL=llama3.1:8b
# DRONEDOCS__JUDGE__MODEL=llama3.1:8b

# Optional: Cohere reranker (set DRONEDOCS__RERANK__PROVIDER=cohere)
# COHERE_API_KEY=

# Any settings.yaml key can be overridden: DRONEDOCS__<SECTION>__<KEY>=value
# DRONEDOCS__RERANK__TOP_N=5
# DRONEDOCS__RETRIEVAL__MODE=hybrid
